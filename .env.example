# Local development uses an in-memory demo store when PostgreSQL settings are omitted.
# To use Yandex Managed PostgreSQL without storing its password locally, authenticate
# the `yc` CLI and configure PGHOST/PGPORT/PGDATABASE/PGUSER plus the Lockbox settings:
# PGHOST=c-cluster-id.rw.mdb.yandexcloud.net
# PGPORT=6432
# PGDATABASE=rollapp
# PGUSER=rollapp_app
# YC_LOCKBOX_SECRET_ID=secret-id
# YC_LOCKBOX_SECRET_KEY=postgresql_password
# YC_LOCKBOX_SOURCE=cli
# YC_FOLDER_ID=folder-id
# Alternatively, provide DATABASE_URL directly.
PORT=8080
# Comma-separated when the same backend serves more than one explicit frontend origin.
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=true

# Yandex ID uses server-side Authorization Code + PKCE. Register a web app at
# https://oauth.yandex.ru/client/new/id/ with this callback for local Vite:
# http://localhost:5173/api/auth/yandex/callback
# Request login:info and login:email; login:avatar may be optional.
# YANDEX_OAUTH_CLIENT_ID=oauth-client-id
# YANDEX_OAUTH_CLIENT_SECRET=oauth-client-secret
# Optional when PUBLIC_APP_URL should not be used to derive the callback:
# YANDEX_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/yandex/callback
# YC_YANDEX_OAUTH_LOCKBOX_SECRET_ID=secret-id
# YC_YANDEX_OAUTH_CLIENT_ID_KEY=client_id
# YC_YANDEX_OAUTH_CLIENT_SECRET_KEY=client_secret

# Password-reset links expire after 30 minutes. In local development the console
# provider prints the link to the server terminal. Production uses Yandex Cloud
# Postbox with the VM service account and a verified sender address.
PUBLIC_APP_URL=http://localhost:5173
EMAIL_PROVIDER=console
EMAIL_FROM=Rollapp <no-reply@rollapp.test>
PASSWORD_RESET_TTL_SECONDS=1800
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_DAILY_LIMIT=5
# YC_POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net/v2/email/outbound-emails
# YC_METADATA_TOKEN_URL=http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token

# Phone OTP is disabled until both a provider and a strong HMAC secret are set.
# `test` is accepted only under NODE_ENV=test; production uses `yandex`.
SMS_PROVIDER=disabled
PHONE_AUTH_SECRET=replace-with-at-least-32-random-characters
YC_CNS_SENDER_ID=Rollapp
# YC_CNS_ENDPOINT=https://notifications.yandexcloud.net/
# YC_METADATA_TOKEN_URL=http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token
PHONE_OTP_TTL_SECONDS=300
PHONE_OTP_RESEND_SECONDS=60
PHONE_OTP_MAX_ATTEMPTS=5
PHONE_OTP_RATE_WINDOW_SECONDS=900
PHONE_OTP_PHONE_REQUEST_LIMIT=3
PHONE_OTP_IP_REQUEST_LIMIT=10
PHONE_OTP_GLOBAL_DAILY_LIMIT=100

# Telegram Mini App authentication and @rollappRFbot webhook. Keep both secrets
# in one Yandex Lockbox version under `bot_token` and `webhook_secret`.
TELEGRAM_BOT_USERNAME=rollappRFbot
TELEGRAM_WEB_APP_URL=https://xn--80avakiab.xn--p1ai/
TELEGRAM_DELIVERY_MODE=polling
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=900
# TELEGRAM_BOT_TOKEN=123456789:replace-me
# TELEGRAM_WEBHOOK_SECRET=replace-with-random-base64url
# YC_TELEGRAM_LOCKBOX_SECRET_ID=secret-id
# YC_TELEGRAM_BOT_TOKEN_KEY=bot_token
# YC_TELEGRAM_WEBHOOK_SECRET_KEY=webhook_secret
