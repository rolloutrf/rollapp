    "check": "npm run check:release",
    "check:comprehensive": "node scripts/check-comprehensive.mjs",
    "check:release": "npm run test:unit && npm run test:ui && npm run test:page-scrollers && npm run test:lab-results && npm run test:controls && npm run test:details && npm run test:dates && npm run test:calendar && npm run test:form-actions && npm run test:text-edit && npm run test:notes && npm run test:kanban && npm run test:drag-drop && npm run test:health && npm run test:medication-photos && npm run build",
    "test:planning:production": "ROLLAPP_TEST_PLANNING=1 node --test server/planning.integration.test.js server/planning-recurrence.integration.test.js",
    "test:visual": "node scripts/visual-smoke.mjs",
    "test:drawers": "DRAWER_REAL_FORMS=1 node scripts/drawer-smoke.mjs",
    "rolls:grant": "node scripts/grant-welcome-rolls.mjs",
    "test:rolls:production": "ROLLAPP_TEST_ROLLS=1 node --test server/rolls.integration.test.js",
    "test:stars:production": "ROLLAPP_TEST_STARS=1 node --test server/roll-stars.integration.test.js",
    "test:openrouter:production": "ROLLAPP_TEST_OPENROUTER=1 node --test server/openrouter-persistence.integration.test.js",
    "test:stars:visual": "ROLLAPP_TEST_STARS=1 STARS_TEST_UI=1 node --test server/roll-stars.integration.test.js",
