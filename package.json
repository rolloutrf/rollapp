    "dotenv": "latest",
    "express": "latest",
    "helmet": "latest",
    "input-otp": "^1.4.2",
    "lucide-react": "latest",
    "next-themes": "^0.4.6",
    "pg": "latest",
    "pg-mem": "latest",
    "react": "latest",
    "react-dom": "latest",
