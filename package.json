    "cdek:import": "node scripts/import-cdek-points.mjs",
    "test:cdek:production": "ROLLAPP_TEST_CDEK=1 node --test server/cdek.integration.test.js",
    "test:cdek:visual": "ROLLAPP_TEST_CDEK=1 CDEK_TEST_UI=1 node --test server/cdek.integration.test.js",
    "test:calendar": "node scripts/calendar-events-smoke.mjs",
    "test:drag-drop": "node scripts/drag-drop-smoke.mjs",
    "test:notes": "node scripts/planning-notes-smoke.mjs",
    "test:notes:production": "ROLLAPP_TEST_NOTES=1 node --test server/notes.integration.test.js",
    "test:notes:production:ui": "ROLLAPP_TEST_NOTES=1 NOTES_TEST_UI=1 node --test server/notes.integration.test.js",
    "test:medication-photos": "node scripts/medication-photo-smoke.mjs"
