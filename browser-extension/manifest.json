{
  "manifest_version": 3,
  "name": "Rollapp — импорт из магазинов",
  "version": "1.3.0",
  "description": "Импорт товаров и избранного из поддерживаемых магазинов в Rollapp.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://samokat.ru/product/*",
    "https://www.samokat.ru/product/*",
    "https://lavka.yandex.ru/good/*",
    "https://lenta.com/product/*",
    "https://www.lenta.com/product/*",
    "https://lenta.com/item/*",
    "https://www.lenta.com/item/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://samokat.ru/product/*",
        "https://www.samokat.ru/product/*",
        "https://lavka.yandex.ru/good/*",
        "https://lenta.com/product/*",
        "https://www.lenta.com/product/*",
        "https://lenta.com/item/*",
        "https://www.lenta.com/item/*"
      ],
      "js": [
        "retailer-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://xn--80avakiab.xn--p1ai/*"
      ],
      "js": [
        "rollapp-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://market.yandex.ru/my/wishlist*",
        "https://market.yandex.ru/wishlist/*",
        "https://www.ozon.ru/my/favorites*",
        "https://www.ozon.ru/selections/*",
        "https://www.ozon.ru/wishlist/*",
        "https://www.ozon.ru/wishlists/*",
        "https://ozon.ru/my/favorites*",
        "https://ozon.ru/selections/*",
        "https://ozon.ru/wishlist/*",
        "https://ozon.ru/wishlists/*",
        "https://www.wildberries.ru/lk/favorites*",
        "https://www.wildberries.ru/wishlist/*",
        "https://wildberries.ru/lk/favorites*",
        "https://wildberries.ru/wishlist/*",
        "https://www.wb.ru/lk/favorites*",
        "https://www.wb.ru/wishlist/*",
        "https://wb.ru/lk/favorites*",
        "https://wb.ru/wishlist/*"
      ],
      "js": [
        "wishlist-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
